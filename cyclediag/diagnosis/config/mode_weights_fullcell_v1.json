        {"feature": "delta_dchg_dQdV_peak1_V", "direction": "either", "weight": 0.7, "scale": 0.02},
        {"feature": "delta_chg_dQdV_peak1_V", "direction": "either", "weight": 0.6, "scale": 0.02},
