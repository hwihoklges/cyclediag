        {"feature": "EoC_dchgR_60s_inc", "direction": "increase", "weight": 1.0, "scale": 20.0},
        {"feature": "EoD_chgR_10s_inc", "direction": "increase", "weight": 1.0, "scale": 20.0},
        {"feature": "EoD_chgR_60s_inc", "direction": "increase", "weight": 0.9, "scale": 20.0},
        {"feature": "EoC_dchgR_10_60_ratio", "direction": "either", "weight": 0.5, "scale": 0.2},
        {"feature": "EoC_restV_tau", "direction": "increase", "weight": 0.5, "scale": 100.0},
