        {"feature": "EoC_dchgR_60s_inc", "direction": "increase", "weight": 1.0, "scale": 20.0},
        {"feature": "EoD_chgR_60s_inc", "direction": "increase", "weight": 1.0, "scale": 20.0},
        {"feature": "EoC_restV_tau", "direction": "increase", "weight": 1.1, "scale": 100.0},
        {"feature": "EoD_restV_tau", "direction": "increase", "weight": 1.0, "scale": 80.0},
        {"feature": "EoC_restV_relax", "direction": "either", "weight": 0.5, "scale": 0.03},
