        {"feature": "CE", "direction": "decrease_from_100", "weight": 0.5, "scale": 3.0,
         "note": "demoted vs CE_local_20"},
        {"feature": "delta_EoC_restV_end", "direction": "decrease", "weight": 0.7, "scale": 0.03},
